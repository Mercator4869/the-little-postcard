[Unit]
Description=Image2Music demo (Little Postcard)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/image2music
Environment="SERVER_HOST=127.0.0.1"
Environment="SERVER_PORT=8000"
Environment="PYTHONUNBUFFERED=1"
# 口令不写在本文件里：放到 /etc/image2music.env（仅 root 可读），
# 内容见项目根目录 .env.example，格式为 KEY=VALUE 每行一个。
EnvironmentFile=-/etc/image2music.env
ExecStart=/srv/image2music/.venv/bin/gunicorn -c /srv/image2music/deploy/gunicorn.conf.py "app:create_app()"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
