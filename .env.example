# ============================================================
#  .env.example —— 复制为 .env 后填写（.env 已被 .gitignore 排除）
#
#  PowerShell:  Copy-Item .env.example .env
#  bash:        cp .env.example .env
#
#  不填写也能跑：本地 127.0.0.1 演示不需要任何口令。
#  一旦要放到局域网 / 公网 / 录屏直播，请务必填上这两项。
# ============================================================

# Flask 会话签名密钥：留空则自动生成并保存在 data/.secret_key（不入库）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# 访客访问口令（可选）：设置后整站需先输入口令；留空 = 关闭门禁
ACCESS_PASSWORD=

# 「开发者」删除明信片入口的口令（可选）：留空 = 关闭该入口
DEV_DELETE_PASSWORD=

# 仅离线降级演示时使用：1 = 不加载 CLIP，上传后直接返回兜底歌曲
# MODEL_DOWNGRADE=0

# 监听地址 / 端口（默认 127.0.0.1:5000）
# SERVER_HOST=127.0.0.1
# SERVER_PORT=5000

# 公开域名（可选）：只对该域名强制 HTTPS 跳转，局域网 IP 不受影响
# PUBLIC_HOST=
